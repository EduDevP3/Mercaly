# ========================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (.env.example)
# Backend: LBM (La Barata Mayoreos) - Plataforma Multi-Tenant
# ========================================================

# --------------------------------------------------------
# 1. SERVIDOR EXPRESS & ENTORNO
# --------------------------------------------------------
# Entorno de ejecución: 'development' | 'production' | 'test'
NODE_ENV=development

# Host y Puerto de escucha local
HOST=localhost
PORT=82

# Prefijo global de la API REST
API_URL=/api/v1


# --------------------------------------------------------
# 2. CONEXIÓN A MONGODB ATLAS (CLÚSTER & BASE MAESTRA)
# --------------------------------------------------------
# Cadena de conexión URI completa provista por MongoDB Atlas (sin incluir nombre de DB al final)
# Formato: mongodb+srv://<usuario>:<password>@<cluster-url>/
CONNECTION_STRING=mongodb+srv://usuario:password@cluster.mongodb.net/

# Nombre de la Base de Datos Maestra (Almacena tenants 'stores', 'users' y telemetría)
DATABASE=LBM

# URI directa completa de MongoDB Atlas
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/LBM

# Credenciales de base de datos (utilizadas para logs o scripts de utilidad)
DB_USER=sa
DB_PASSWORD=tu_password_seguro


# --------------------------------------------------------
# 3. SEGURIDAD, JWT & CLAVES DE ACCESO
# --------------------------------------------------------
# Clave secreta para firmar y verificar tokens JWT (usar una cadena larga y aleatoria)
JWT_SECRET=tu_clave_secreta_jwt_muy_segura_2026

# Clave maestra para permitir el registro administrativo inicial de forma segura
ADMIN_REGISTRATION_KEY=LBM_ADMIN_MASTER_SETUP_2026


# --------------------------------------------------------
# 4. CONFIGURACIÓN MULTI-TENANT & SUPER ADMIN
# --------------------------------------------------------
# Slug de la tienda por defecto cuando no se envía la cabecera 'x-tenant-slug'
DEFAULT_STORE_SLUG=lbm-mayoreos

# Teléfono internacional del Super Administrador para soporte y comprobantes por WhatsApp
# Formato numérico internacional sin símbolos (Ej: 52 + 10 dígitos)
SUPER_ADMIN_WHATSAPP=523221045519

# Correo electrónico de contacto del Super Administrador
SUPER_ADMIN_DEFAULT_EMAIL=superadmin@lbm.com


# --------------------------------------------------------
# 5. ORÍGENES FRONTEND PERMITIDOS (CORS)
# --------------------------------------------------------
# URL del panel administrativo (Vite / Netlify)
FRONTEND_URL=http://localhost:3000

# URL de la tienda pública (Next.js / Vercel)
STORE_URL=http://localhost:3001


# --------------------------------------------------------
# 6. CLOUDINARY (ALMACENAMIENTO MULTIMEDIA DE PRODUCTOS)
# --------------------------------------------------------
# Credenciales del panel de control de Cloudinary (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
